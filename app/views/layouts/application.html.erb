<!DOCTYPE html>
<html>
<head>
  <title>Free Games</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <%= stylesheet_link_tag 'application', media: 'all' %>
  <%= csrf_meta_tags %>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.css" rel="stylesheet">
  
  
</head>
<body>
<ul class="menu menu-hover-lines">
<li class="free-games"><%= link_to  'Free Games', root_path %></li>
  
<% if logged_in? %>
  <span>Welcome, <%= current_user.name %></span>
  <%= link_to "Logout", logout_path %>
  
  <!-- Favorite functionality remains the same -->
  <% if @game && current_user %>
    <% if current_user.favorites.exists?(@game.id) %>
      <%= button_to "Remove from Favorites", 
          api_v1_favorite_game_path(current_user.favorite_games.find_by(game_id: @game.id)), 
          method: :delete %>
    <% else %>
      <%= button_to "Add to Favorites", 
          api_v1_favorite_games_path(game_id: @game.id), 
          method: :post %>
    <% end %>
  <% end %>
<% else %>
<%= link_to "Login", login_path %>
<% end %>
    
  </div>
</ul>

  <%- flash.each do |key, value| -%>
    <div class="flash flash-<%= key %>">
      <%= value %>
    </div>
  <%- end -%>

  <%= yield %>

<%# <%= javascript_include_tag 'application' %> %>

  
  <%- if Rails.env.development? || Rails.env.test? -%> 
    <%= javascript_tag do %>
      window.railsEnv = '<%= Rails.env %>'
    <%- end -%>
  <%- end -%>
  <%= javascript_pack_tag 'application' %>
  
  <%= yield :extra_footer %>
</body>
</html>
